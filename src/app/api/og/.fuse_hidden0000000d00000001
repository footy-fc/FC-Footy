export async function GET(request: Request) {
  const { searchParams, origin } = new URL(request.url);

  // Check for override params
  const homeParam = searchParams.get("home");
  const awayParam = searchParams.get("away");
  const homeScoreParam = searchParams.get("homeScore");
  const awayScoreParam = searchParams.get("awayScore");
  const statusParam = searchParams.get("status");
  const leagueParam = searchParams.get("league");
  const isLiveParam = searchParams.get("isLive");

  let matchPromise: Promise<MatchCard | null>;

  if (homeParam && awayParam) {
    // Use params if provided
    const isLive = isLiveParam === "true";
    const statusLabel = truncate(statusParam || (isLive ? "LIVE" : "FT"), 13).toUpperCase();
    matchPromise = Promise.resolve({
      homeAbbr: truncate(homeParam, 4).toUpperCase(),
      awayAbbr: truncate(awayParam, 4).toUpperCase(),
      homeScore: homeScoreParam || "0",
      awayScore: awayScoreParam || "0",
      homeLogo: null,
      awayLogo: null,
      statusLabel,
      isLive,
      isUpcoming: false,
      leagueName: truncate(leagueParam || "MATCH", 10).toUpperCase(),
    });
  } else {
    matchPromise = fetchBestMatch().catch(() => null);
  }

  const [match, clubs] = await Promise.all([
    matchPromise,
    fetchTopFanclubs(origin).catch(() => [] as FanclubCard[]),
  ]);

  // Team badges are optional decoration – never let them break the render.
  if (match && (match.homeLogo || match.awayLogo)) {
    const [homeLogo, awayLogo] = await Promise.all([
      toDataUrl(match.homeLogo),
      toDataUrl(match.awayLogo),
    ]);
    match.homeLogo = homeLogo;
    match.awayLogo = awayLogo;
  }

  return new ImageResponse(<OgFrame match={match} clubs={clubs} />, {
    ...size,
    headers: {
      "Cache-Control":
        "public, max-age=120, s-maxage=120, stale-while-revalidate=60",
    },
  });
}
