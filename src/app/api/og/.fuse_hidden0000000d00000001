    type: ESPNStatusType;
  };
}

interface ESPNEvent {
  id: string;
  name: string;
  date?: string;
  competitions?: ESPNCompetition[];
}

interface ESPNResponse {
  events?: ESPNEvent[];
  leagues?: { abbreviation?: string }[];
}

interface MatchCard {
  homeAbbr: string;
  awayAbbr: string;
  homeScore: string;
  awayScore: string;
  homeLogo: string | null;
  awayLogo: string | null;
  statusLabel: string; // e.g. "LIVE", "45'", "HT", "FT", "SAT 19:30"
  isLive: boolean;
  isUpcoming: boolean;
  leagueName: string;
}

interface FanclubCard {
  teamId: string;
  name: string;
  abbreviation: string;
  logo: string | null;
  fanCount: number;
}

const LEAGUES = [
  { name: "EPL", id: "eng.1" },
  { name: "UCL", id: "uefa.champions" },
  { name: "LALIGA", id: "esp.1" },
  { name: "SERIE A", id: "ita.1" },
  { name: "BUNDES", id: "ger.1" },
  { name: "LIGUE 1", id: "fra.1" },
  { name: "FA CUP", id: "eng.fa" },
  { name: "UEL", id: "uefa.europa" },
  { name: "CWC", id: "fifa.cwc" },
];

const DAY_LABELS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];

/**
 * ESPN's `shortDetail` for upcoming games is a full sentence
 * ("Fri, August 21st at 3:00 PM EDT") which blows past the card width.
 * Build a compact, timezone-explicit label from the ISO kickoff instead.
 */
function formatKickoff(iso: string | undefined): string {
  if (!iso) return "UPCOMING";
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "UPCOMING";

  const day = DAY_LABELS[date.getUTCDay()];
  const hours = String(date.getUTCHours()).padStart(2, "0");
  const minutes = String(date.getUTCMinutes()).padStart(2, "0");
  return `${day} ${hours}:${minutes} UTC`;
}

/** Live clock strings ("45'", "90'+3") stay short; anything else gets clipped. */
function formatLiveLabel(shortDetail: string | undefined): string {
  const clean = (shortDetail ?? "").trim();
  if (!clean) return "LIVE";
  const compact = clean.split(" - ")[0];
  return truncate(compact, 9).toUpperCase();
}

async function fetchBestMatch(): Promise<MatchCard | null> {
  // Try each league in priority order until we find a live → post → pre match
  let bestLive: MatchCard | null = null;
  let bestPost: MatchCard | null = null;
  let bestPre: MatchCard | null = null;

  for (const league of LEAGUES) {
    try {
      const url = `https://site.web.api.espn.com/apis/site/v2/sports/soccer/${league.id}/scoreboard`;
      const res = await fetch(url, {
        cache: "no-store",
        signal: AbortSignal.timeout(4000),
      });
      if (!res.ok) continue;
      const data = (await res.json()) as ESPNResponse;
      if (!data.events?.length) continue;

      for (const event of data.events) {
        const comp = event.competitions?.[0];
        if (!comp?.competitors || !comp.status) continue;

        const home = comp.competitors.find((c) => c.homeAway === "home");
        const away = comp.competitors.find((c) => c.homeAway === "away");
        if (!home || !away) continue;

        const state = comp.status.type.state;
        const statusName = comp.status.type.name;

        let statusLabel = "";
        let isLive = false;
        let isUpcoming = false;

        if (state === "in") {
          isLive = true;
          statusLabel =
            statusName === "STATUS_HALFTIME"
              ? "HT"
              : formatLiveLabel(comp.status.type.shortDetail);
        } else if (state === "post") {
          statusLabel = "FT";
        } else {
          isUpcoming = true;
          statusLabel = formatKickoff(comp.date ?? event.date);
        }

        const card: MatchCard = {
          homeAbbr: truncate(
            home.team.abbreviation ||
              (home.team.shortDisplayName || home.team.displayName).substring(0, 3),
            4
          ).toUpperCase(),
          awayAbbr: truncate(
            away.team.abbreviation ||
              (away.team.shortDisplayName || away.team.displayName).substring(0, 3),
            4
          ).toUpperCase(),
          homeScore: home.score ?? "0",
          awayScore: away.score ?? "0",
          homeLogo: home.team.logo ?? null,
          awayLogo: away.team.logo ?? null,
          statusLabel,
          isLive,
          isUpcoming,
          // Our own short name beats ESPN's abbreviation ("ENG.1"), which is
          // both ugly and too wide for the card.
          leagueName: league.name,
        };

        if (state === "in" && !bestLive) {
          bestLive = card;
        } else if (state === "post" && !bestPost) {
          bestPost = card;
        } else if (state === "pre" && !bestPre) {
          bestPre = card;
        }
      }

      // Prefer live matches – break early if we found one
      if (bestLive) break;
    } catch {
      // network error – skip league
      continue;
    }
  }

  return bestLive ?? bestPost ?? bestPre ?? null;
}

/* ------------------------------------------------------------------ */
/*  Fan club data                                                     */
