interface TopFanclubResponse {
  ok?: boolean;
  clubs?: Array<{
    teamId?: string;
    name?: string;
    abbreviation?: string;
    logoUrl?: string;
    fanCount?: number;
  }>;
}

async function fetchTopFanclubs(origin: string): Promise<FanclubCard[]> {
  try {
    const res = await fetch(`${origin}/api/fanclubs/top?limit=3`, {
      cache: "no-store",
      signal: AbortSignal.timeout(3000),
    });
    if (!res.ok) return [];

    const data = (await res.json()) as TopFanclubResponse;
    if (!data?.clubs?.length) return [];

    const clubs = data.clubs
      .filter((club) => club?.name && Number(club.fanCount) > 0)
      .slice(0, 3);

    const logos = await Promise.all(clubs.map((club) => toDataUrl(club.logoUrl)));

    return clubs.map((club, index) => ({
      teamId: club.teamId ?? String(index),
      name: club.name as string,
      abbreviation: (club.abbreviation || club.name || "").toUpperCase(),
      logo: logos[index],
      fanCount: Number(club.fanCount) || 0,
    }));
  } catch {
    return [];
  }
}

